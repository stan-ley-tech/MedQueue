# Application
APP_ENV=development
APP_NAME=medqueue
HTTP_PORT=8080
SHUTDOWN_TIMEOUT_SECONDS=15

# PostgreSQL
DATABASE_URL=postgres://medqueue:medqueue@localhost:5432/medqueue?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Background worker
REMINDER_SCAN_INTERVAL_SECONDS=60
REMINDER_LOOKAHEAD_MINUTES=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
